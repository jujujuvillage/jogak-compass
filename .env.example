# ── 필수 ─────────────────────────────────────────────
# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# DART 오픈API 인증키 (https://opendart.fss.or.kr → 인증키 신청/관리)
DART_API_KEY=

# ── 선택 ─────────────────────────────────────────────
# 사용할 GPT 모델 (기본값: gpt-5.4-mini). 구조화 출력(JSON schema)을 지원하는 모델이어야 해요.
OPENAI_MODEL=gpt-5.4-mini

# 분석 결과 공유 저장 + 요청 제한용 Redis (Vercel Marketplace의 Upstash Redis).
# 비워 두면 서버 메모리만 사용해요(서버가 재시작되면 캐시가 사라지고, 요청 제한이 느슨해져요).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IP당 하루 신고서 분석 횟수 / 시간당 챗봇 질문 횟수
RATE_LIMIT_ANALYZE_PER_DAY=15
RATE_LIMIT_CHAT_PER_HOUR=40
